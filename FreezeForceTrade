-- トグルを作る関数
local function createToggle(parent, position, labelText)
	local container = Instance.new("Frame")
	container.Size = UDim2.new(0, 230, 0, 50)
	container.Position = position
	container.BackgroundTransparency = 1
	container.Parent = parent

	-- ラベル
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0.6, 0, 1, 0)
	label.Position = UDim2.new(0, 0, 0, 0)
	label.BackgroundTransparency = 1
	label.Text = labelText
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextScaled = true
	label.Parent = container

	-- トグルの背景（横長で細め）
	local toggleBG = Instance.new("TextButton")
	toggleBG.Size = UDim2.new(0, 60, 0, 25)
	toggleBG.Position = UDim2.new(0.75, 0, 0.25, 0)
	toggleBG.BackgroundColor3 = Color3.fromRGB(150, 150, 150) -- グレー（OFF）
	toggleBG.BorderSizePixel = 0
	toggleBG.AutoButtonColor = false
	toggleBG.Parent = container

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = toggleBG

	-- 丸いノブ
	local knob = Instance.new("Frame")
	knob.Size = UDim2.new(0, 23, 0, 23)
	knob.Position = UDim2.new(0, 1, 0, 1) -- 左側（OFF）
	knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	knob.Parent = toggleBG
	knob.BorderSizePixel = 0

	local knobCorner = Instance.new("UICorner")
	knobCorner.CornerRadius = UDim.new(1, 0)
	knobCorner.Parent = knob

	-- 状態
	local isOn = false

	-- 切り替え処理
	toggleBG.MouseButton1Click:Connect(function()
		isOn = not isOn

		-- ノブの移動
		local knobTween = TweenService:Create(knob, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = isOn and UDim2.new(1, -24, 0, 1) or UDim2.new(0, 1, 0, 1)
		})
		-- 背景色の変更
		local colorTween = TweenService:Create(toggleBG, TweenInfo.new(0.2), {
			BackgroundColor3 = isOn and Color3.fromRGB(0, 170, 0) or Color3.fromRGB(150, 150, 150)
		})

		-- 実行
		knobTween:Play()
		colorTween:Play()
	end)
end

-- 2つ作成
createToggle(frame, UDim2.new(0, 10, 0, 35), "Trade Freeze")
createToggle(frame, UDim2.new(0, 10, 0, 95), "Force Accept")
