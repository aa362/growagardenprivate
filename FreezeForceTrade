-- トグルを作る関数
local function createToggle(parent, position, labelText)
	local container = Instance.new("Frame")
	container.Size = UDim2.new(0, 230, 0, 50)
	container.Position = position
	container.BackgroundTransparency = 1
	container.Parent = parent

	-- ラベル
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0.6, 0, 1, 0)
	label.Position = UDim2.new(0, 0, 0, 0)
	label.BackgroundTransparency = 1
	label.Text = labelText
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextScaled = true
	label.Parent = container

	-- トグルの背景
	local toggleBG = Instance.new("Frame")
	toggleBG.Size = UDim2.new(0.35, 0, 0.6, 0)
	toggleBG.Position = UDim2.new(0.65, 0, 0.2, 0)
	toggleBG.BackgroundColor3 = Color3.fromRGB(170, 0, 0) -- 赤（OFF）
	toggleBG.BorderSizePixel = 0
	toggleBG.Parent = container
	toggleBG.CornerRadius = UDim.new(1, 0)

	-- 丸いスライダー
	local knob = Instance.new("Frame")
	knob.Size = UDim2.new(0.5, 0, 1, 0)
	knob.Position = UDim2.new(0, 0, 0, 0)
	knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	knob.Parent = toggleBG
	knob.BorderSizePixel = 0
	knob.CornerRadius = UDim.new(1, 0)

	-- 状態
	local isOn = false

	-- クリックで切り替え
	toggleBG.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			isOn = not isOn

			-- Tweenの設定
			local knobTween = TweenService:Create(knob, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Position = isOn and UDim2.new(0.5, 0, 0, 0) or UDim2.new(0, 0, 0, 0)
			})
			local colorTween = TweenService:Create(toggleBG, TweenInfo.new(0.2), {
				BackgroundColor3 = isOn and Color3.fromRGB(0, 170, 0) or Color3.fromRGB(170, 0, 0)
			})

			-- 実行
			knobTween:Play()
			colorTween:Play()
		end
	end)
end

-- 2つ作成（タイトルの下から配置）
createToggle(frame, UDim2.new(0, 10, 0, 30), "Trade Freeze")
createToggle(frame, UDim2.new(0, 10, 0, 90), "Force Accept")
